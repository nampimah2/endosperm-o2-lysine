24310  /
24311   
24312      v_max_mod(j) modified max bounds
24313      v_min_mod(j) modified min bounds
24314      result_biomass(j)    biomass when j is overexpressed
24315      result_r00451(j)     R00451 flux when j is overexpressed
24316      base_biomass         baseline biomass
24317      base_r00451          baseline R00451
24318  ;
24319   
24320  EQUATIONS
24321      objective
24322      mass_balance1(i)
24323      lower_bound(j)
24324      upper_bound(j)
24325  ;
24326   
24327  FREE VARIABLES
24328      v(j)
GAMS 24.7.4  r58773 Released Sep 19, 2016 LEX-LEG x86 64bit/Linux                                                                                                                                                                    03/03/26 16:54:33 Page 460
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


24329      obj
24330  ;
24331   
24332  objective..         obj =e= v('Seed_Biomass[K]');
24333  mass_balance1(i)..  sum(j, S(i,j) * v(j)) =e= 0;
24334  lower_bound(j)..    v_min_mod(j) =l= v(j);
24335  upper_bound(j)..    v(j) =l= v_max_mod(j);
24336   
24337  Model fba_screen /all/;
24338  fba_screen.optfile = 1;
24339  fba_screen.holdfixed = 1;
24340   
24341  * -------- Baseline solve --------
24342  v_max_mod(j) = v_max_orig(j);
24343  v_min_mod(j) = v_min_orig(j);
24344  Solve fba_screen using lp maximizing obj;
24345  base_biomass = v.l('Seed_Biomass[K]');
24346  base_r00451  = v.l('R00451[K,p]');
24347   
24348  * -------- Overexpression loop --------
24349  ALIAS(j, jj);
24350   
24351  loop(jj$(v_max_orig(jj) > 1e-12 or v_min_orig(jj) < -1e-12),
24352      v_max_mod(j) = v_max_orig(j);
24353      v_min_mod(j) = v_min_orig(j);
24354   
24355      v_max_mod(jj) = v_max_orig(jj) * 2.0;
24356      if(v_min_orig(jj) < 0,
24357          v_min_mod(jj) = v_min_orig(jj) * 2.0;
24358      );
24359   
24360      Solve fba_screen using lp maximizing obj;
24361   
24362      if(fba_screen.modelstat = 1 or fba_screen.modelstat = 2,
24363          result_biomass(jj) = v.l('Seed_Biomass[K]');
24364          result_r00451(jj)  = v.l('R00451[K,p]');
24365      else
24366          result_biomass(jj) = -999;
24367          result_r00451(jj)  = -999;
24368      );
24369  );
24370   
24371  * -------- Output Results --------
24372  FILE RESULTS /'results_overexpression.txt'/;
24373  PUT RESULTS;
24374  PUT "BASELINE_BIOMASS ", base_biomass:0:10 /;
24375  PUT "BASELINE_R00451 ", base_r00451:0:10 /;
24376  PUT "REACTION BIOMASS R00451" /;
24377  loop(jj$(result_r00451(jj) ne 0),
24378      put jj.tl:0:40, " ", result_biomass(jj):0:10, " ", result_r00451(jj):0:10 /;
24379  );
24380  PUTCLOSE;
