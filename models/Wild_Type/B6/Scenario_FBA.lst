24321  /
24322   
24323  * Save original bounds for restoration between scenarios
24324          v_max_orig(j)           original maximum flux
24325          v_min_orig(j)           original minimum flux
24326   
24327  * Results storage
24328          res_biomass(sc)         biomass for each scenario
GAMS 24.7.4  r58773 Released Sep 19, 2016 LEX-LEG x86 64bit/Linux                                                                                                                                                                    03/05/26 12:12:55 Page 460
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


24329          res_lysine(sc)          R00451 flux for each scenario
24330          res_dhdps(sc)           R02292 flux for each scenario
24331          res_lysExch(sc)         Exchange_C00047 flux for each scenario
24332          res_status(sc)          solver status for each scenario
24333  ;
24334   
24335  * Store originals
24336  v_max_orig(j) = v_max(j);
24337  v_min_orig(j) = v_min(j);
24338   
24339  **************************************************************
24340   
24341  *********Defining Equations***********************************
24342  EQUATIONS
24343          objective               objective function
24344          mass_balance1(i)        steady state mass balance
24345          lower_bound(j)          lower bounds on reactions
24346          upper_bound(j)          upper bounds on reactions
24347  ;
24348  **************************************************************
24349   
24350  *********Defining Variables***********************************
24351  FREE VARIABLES
24352          v(j)                    reaction flux
24353          obj                     objective value
24354  ;
24355  ****************************************************************
24356   
24357  ***************Defining Model***********************************
24358  objective..             obj =e= v('Seed_Biomass[K]');
24359  mass_balance1(i)..      sum(j, S(i,j) * v(j)) =e= 0;
24360  lower_bound(j)..        v_min(j) =l= v(j);
24361  upper_bound(j)..        v(j) =l= v_max(j);
24362   
24363  Model endosperm_fba /all/;
24364  endosperm_fba.optfile = 1;
24365  endosperm_fba.holdfixed = 1;
24366  ******************************************************************
24367   
24368  *************************************************************
24369  * MACRO: Restore all bounds to original values
24370  *************************************************************
24371  $macro RESTORE_BOUNDS v_max(j) = v_max_orig(j); v_min(j) = v_min_orig(j);
24372   
24373  *************************************************************
24374  * MACRO: Record results for scenario sc_idx
24375  *************************************************************
24376  $macro RECORD_RESULTS(sc_idx) \
24377    res_biomass(sc_idx) = obj.l; \
24378    res_status(sc_idx) = endosperm_fba.modelstat; \
24379    res_lysine(sc_idx)  = v.l('R00451[K,p]'); \
24380    res_dhdps(sc_idx)   = v.l('R02292[K,p]'); \
24381    res_lysExch(sc_idx) = v.l('Exchange_C00047[K,L]');
