24316      objective
24317      mass_balance(i)
24318      lower_bound(j)
24319      upper_bound(j)
24320  ;
24321   
24322  objective..              obj =e= v('R00451[K,p]');
24323  mass_balance(i)..        sum(j, S(i,j) * v(j)) =e= 0;
24324  lower_bound(j)..         v_min(j) =l= v(j);
24325  upper_bound(j)..         v(j) =l= v_max(j);
24326   
24327  Model fba /all/;
24328  fba.optfile = 1;
